# Everything here is downloaded into every site that installs the addon
# unless it is export-ignored. Tests, CI config, the docs site and the
# listing artwork are not something a consumer needs in their vendor/ directory.

/.github            export-ignore
/tests              export-ignore
/docs               export-ignore
/art                export-ignore
/screenshots        export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/.editorconfig      export-ignore
/phpunit.xml        export-ignore
/phpunit.xml.dist   export-ignore
/pint.json          export-ignore
/phpstan.neon       export-ignore
/phpstan-baseline.neon export-ignore
/addon-lint.json    export-ignore

# Keep: /config, /resources/views, /src, README.md, CHANGELOG.md,
# UPGRADE.md, LICENSE.
