{
  "name": "goldnead/statamic-toc",
  "description": "Automatic table of contents generator for Statamic Bard, Markdown and HTML fields.",
  "type": "statamic-addon",
  "license": "proprietary",
  "keywords": [
    "statamic",
    "statamic-addon",
    "table-of-contents",
    "bard"
  ],
  "autoload": {
    "psr-4": {
      "Goldnead\\StatamicToc\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Goldnead\\StatamicToc\\Tests\\": "tests"
    }
  },
  "extra": {
    "statamic": {
      "slug": "statamic-toc",
      "name": "Statamic ToC",
      "description": "Automatic table of contents generator for Statamic Bard, Markdown and HTML fields.",
      "url": "https://github.com/goldnead/statamic-toc",
      "developer": "Adrian Goldner",
      "developer-url": "https://gldnr.studio"
    },
    "laravel": {
      "providers": [
        "Goldnead\\StatamicToc\\ServiceProvider"
      ]
    }
  },
  "authors": [
    {
      "name": "Adrian Goldner",
      "email": "info@adriangoldner.com"
    }
  ],
  "support": {
    "issues": "https://github.com/goldnead/statamic-toc/issues",
    "source": "https://github.com/goldnead/statamic-toc"
  },
  "require": {
    "php": "^8.2",
    "statamic/cms": "^5.0 | ^6.0",
    "league/commonmark": "^2.0"
  },
  "require-dev": {
    "larastan/larastan": "^3.0",
    "laravel/pint": "^1.18",
    "orchestra/testbench": "^9.0 | ^10.0",
    "phpunit/phpunit": "^10.5 | ^11.0",
    "spatie/test-time": "^1.2"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": true
  },
  "scripts": {
    "test": [
      "php -d memory_limit=-1 -d max_execution_time=0 ./vendor/bin/phpunit"
    ],
    "lint": [
      "./vendor/bin/pint --test"
    ],
    "fix": [
      "./vendor/bin/pint"
    ],
    "analyse": [
      "./vendor/bin/phpstan analyse"
    ]
  }
}
